# Скопіюй у .env локально. На Render додай ті самі ключі в Environment.

DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority"

# Довгий випадковий рядок; у production обов'язковий (див. server.ts)
JWT_SECRET=

# Один URL фронту для CORS (production)
FRONTEND_URL=http://localhost:3000

# Або кілька через кому (прод + превʼю Vercel):
# FRONTEND_URLS=https://app.vercel.app,https://app-git-main-xxx.vercel.app

# Тимчасово для діагностики 500 на /register (потім вимкнути):
# AUTH_ERROR_DETAIL=1

# Опційно: префікс імені проєкту на Vercel (без -gilt / -git-main), щоб CORS пускав усі
# https://ПРОЄКТ-*.vercel.app (production + preview). Приклад: employee-time-tracking
# VERCEL_ORIGIN_SLUG=employee-time-tracking

# Опційно; на Render задається автоматично
# PORT=5000
